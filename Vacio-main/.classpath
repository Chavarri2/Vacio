<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" path="Vacio/src"/>
	<classpathentry kind="src" path="Vacio/resources"/>
	<classpathentry kind="lib" path="Vacio/lib/jackson-annotations-2.17.2.jar"/>
	<classpathentry kind="lib" path="Vacio/lib/jackson-core-2.17.2.jar"/>
	<classpathentry kind="lib" path="Vacio/lib/jackson-databind-2.17.2.jar"/>
	<classpathentry kind="output" path="Vacio/bin"/>
</classpath>
